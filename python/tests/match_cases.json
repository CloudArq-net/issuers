  "synthetic": [
    {
      "why": "an exact issuer beats a pattern that also matches it",
      "census": [
        {"name": "pattern", "issuer": "https://<tenant>.example.com/x", "tenant_placeholder": "<tenant>", "tenant_kind": "name"},
        {"name": "exact", "issuer": "https://acme.example.com/x"}
      ],
      "cases": [
        {"issuer": "https://acme.example.com/x", "entry": "https://acme.example.com/x", "tenant": ""},
        {"issuer": "https://other.example.com/x", "entry": "https://<tenant>.example.com/x", "tenant": "other"}
      ]
    },
    {
      "why": "of two patterns that match, the one with more literal characters wins, whatever the order",
      "census": [
        {"name": "wide", "issuer": "https://<a>.example.com/<b>/<c>", "tenant_placeholder": "<a>", "tenant_kind": "name"},
        {"name": "narrow", "issuer": "https://<a>.example.com/org/<b>", "tenant_placeholder": "<b>", "tenant_kind": "id"}
      ],
      "cases": [
        {"issuer": "https://h.example.com/org/y", "entry": "https://<a>.example.com/org/<b>", "tenant": "y"},
        {"issuer": "https://h.example.com/team/y", "entry": "https://<a>.example.com/<b>/<c>", "tenant": "h"}
      ]
    },
    {
      "why": "two patterns with as many literal characters: the first in census order wins",
      "census": [
        {"name": "first", "issuer": "https://<a>.example.com/<b>/x", "tenant_placeholder": "<b>", "tenant_kind": "name"},
        {"name": "second", "issuer": "https://<a>.example.com/y/<b>", "tenant_placeholder": "<a>", "tenant_kind": "name"}
      ],
      "cases": [
        {"issuer": "https://h.example.com/y/x", "entry": "https://<a>.example.com/<b>/x", "tenant": "y"}
      ]
    },
    {
      "why": "the same two patterns in the other order",
      "census": [
        {"name": "second", "issuer": "https://<a>.example.com/y/<b>", "tenant_placeholder": "<a>", "tenant_kind": "name"},
        {"name": "first", "issuer": "https://<a>.example.com/<b>/x", "tenant_placeholder": "<b>", "tenant_kind": "name"}
      ],
      "cases": [
        {"issuer": "https://h.example.com/y/x", "entry": "https://<a>.example.com/y/<b>", "tenant": "h"}
      ]
    },
    {
